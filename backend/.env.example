# --------------------------------------------------------
# Configuración de Base de Datos
# --------------------------------------------------------
# Formato: proveedor://usuario:contraseña@host:puerto/nombre_base_datos
# Ejemplo para PostgreSQL local:
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/desarrollo-web"

# --------------------------------------------------------
# Seguridad / Autenticación
# --------------------------------------------------------
# Cadena aleatoria para firmar y verificar los tokens JWT.
# Recomendado: Usa una cadena larga y compleja.
ACCESS_TOKEN_SECRET="123"
